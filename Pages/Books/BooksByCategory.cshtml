@page
@model Iancau_Maria_Lab2.Pages.Books.BooksByCategoryModel

@{
    ViewData["Title"] = "Books by Category";
}

<h1>Books in Category: @Model.CategoryName</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Books[0].Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Books[0].Author.FullName) <!-- Use FullName here -->
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model.Books)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => book.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => book.Author.FullName) <!-- And here -->
                </td>
            </tr>
        }
    </tbody>
</table>

