@page
@model Iancau_Maria_Lab2.Pages.Books.DetailsModel

@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>

<div>
    <h4>Title</h4>
    <hr />
    <p>@Model.Book.Title</p>
</div>
<div>
    <h4>Author</h4>
    <hr />
    <p>@Model.Book.Author.FullName</p>
</div>
<div>
    <h4>Price</h4>
    <hr />
    <p>@Model.Book.Price</p>
</div>
<div>
    <h4>Publishing Date</h4>
    <hr />
    <p>@Model.Book.PublishingDate.ToString("d")</p>
</div>
<div>
    <h4>Publisher</h4>
    <hr />
    <p>@Model.Book.Publisher.PublisherName</p>
</div>

<div>
    <h4>Categories</h4>
    <hr />
    <ul>
        @foreach (var category in Model.Categories)
        {
            <li>@category.CategoryName</li>
        }
    </ul>
</div>

<a asp-page="./Index" class="btn btn-primary">Back to List</a>

